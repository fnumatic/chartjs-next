{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es6",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "lib": ["dom", "es5", "scripthost", "es2019"],
    "types": ["node"],
    "paths": {
      "src/*": ["./src/*"]
    }
  },
  "include": ["*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
